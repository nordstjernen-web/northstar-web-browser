+/* remember a successful match for the legacy RegExp statics */
+static void js_regexp_set_last_match(JSContext *ctx, JSValueConst str_val,
+                                     uint8_t **capture, int capture_count,
+                                     const uint8_t *str_buf, int shift)
+{
+    int i;
+
+    if (JS_VALUE_GET_PTR(ctx->regexp_last_input) != JS_VALUE_GET_PTR(str_val) ||
+        JS_VALUE_GET_TAG(ctx->regexp_last_input) != JS_TAG_STRING) {
+        JS_FreeValue(ctx, ctx->regexp_last_input);
+        ctx->regexp_last_input = js_dup(str_val);
+    }
+    for(i = 0; i < 10; i++) {
+        int start = -1, end = -1;
+        if (i < capture_count && capture[2 * i] && capture[2 * i + 1]) {
+            start = (capture[2 * i] - str_buf) >> shift;
+            end = (capture[2 * i + 1] - str_buf) >> shift;
+        }
+        ctx->regexp_last_capture[2 * i] = start;
+        ctx->regexp_last_capture[2 * i + 1] = end;
+    }
+}
+
+enum {
+    JS_REGEXP_LEGACY_INPUT = 10,
+    JS_REGEXP_LEGACY_LAST_MATCH,
+    JS_REGEXP_LEGACY_LAST_PAREN,
+    JS_REGEXP_LEGACY_LEFT_CONTEXT,
+    JS_REGEXP_LEGACY_RIGHT_CONTEXT,
+};
+
+/* RegExp.$1 .. RegExp.$9 (magic 1..9), RegExp.input, lastMatch, lastParen,
+   leftContext and rightContext, with their $_ $& $+ $` $' aliases */
+static JSValue js_regexp_get_legacy(JSContext *ctx, JSValueConst this_val,
+                                    int magic)
+{
+    JSString *str;
+    const int *cap = ctx->regexp_last_capture;
+    int start, end, i;
+
+    if (JS_VALUE_GET_TAG(ctx->regexp_last_input) != JS_TAG_STRING)
+        return js_empty_string(ctx->rt);
+    str = JS_VALUE_GET_STRING(ctx->regexp_last_input);
+    switch(magic) {
+    case JS_REGEXP_LEGACY_INPUT:
+        return js_dup(ctx->regexp_last_input);
+    case JS_REGEXP_LEGACY_LAST_MATCH:
+        start = cap[0], end = cap[1];
+        break;
+    case JS_REGEXP_LEGACY_LAST_PAREN:
+        start = end = -1;
+        for(i = 9; i >= 1; i--) {
+            if (cap[2 * i] >= 0) {
+                start = cap[2 * i], end = cap[2 * i + 1];
+                break;
+            }
+        }
+        break;
+    case JS_REGEXP_LEGACY_LEFT_CONTEXT:
+        start = 0, end = cap[0];
+        break;
+    case JS_REGEXP_LEGACY_RIGHT_CONTEXT:
+        start = cap[1], end = str->len;
+        break;
+    default:
+        start = cap[2 * magic], end = cap[2 * magic + 1];
+        break;
+    }
+    if (start < 0 || end < start || (uint32_t)end > str->len)
+        return js_empty_string(ctx->rt);
+    return js_sub_string(ctx, str, start, end);
+}
+
+static JSValue js_regexp_set_legacy_input(JSContext *ctx, JSValueConst this_val,
+                                          JSValueConst val, int magic)
+{
+    JSValue str = JS_ToString(ctx, val);
+    int i;
+
+    if (JS_IsException(str))
+        return JS_EXCEPTION;
+    JS_FreeValue(ctx, ctx->regexp_last_input);
+    ctx->regexp_last_input = str;
+    for(i = 0; i < 20; i++)
+        ctx->regexp_last_capture[i] = -1;
+    return JS_UNDEFINED;
+}
