 } REFirstChars;
 
+static void re_first_add_range(REFirstChars *fc, uint32_t low, uint32_t high)
+{
+    uint32_t c;
+
+    if (high >= 128) {
+        fc->non_ascii = true;
+        high = 127;
+    }
+    for(c = low; c <= high; c++)
+        fc->ascii[c >> 5] |= 1u << (c & 31);
+}
+
+/* first characters of a character class. 'pc' points to the opcode */
+static bool re_first_add_class(REFirstChars *fc, const uint8_t *pc,
+                               bool is_unicode, bool allow_slow)
+{
+    bool is_32 = (*pc == REOP_range32 || *pc == REOP_range32_i);
+    bool ignore_case = (*pc == REOP_range_i || *pc == REOP_range32_i);
+    int n = get_u16(pc + 1), i;
+    uint32_t c, low, high;
+
+    pc += 3;
+    if (!ignore_case) {
+        for(i = 0; i < n; i++) {
+            if (is_32) {
+                low = get_u32(pc + i * 8);
+                high = get_u32(pc + i * 8 + 4);
+            } else {
+                low = get_u16(pc + i * 4);
+                high = get_u16(pc + i * 4 + 2);
+            }
+            if (low < 128)
+                re_first_add_range(fc, low, high);
+            else
+                fc->non_ascii = true;
+        }
+        return true;
+    }
+    /* the subject character is canonicalized before it is compared: find
+       the ASCII characters that land in the class. Too slow to be worth
+       it for a short subject. */
+    if (!allow_slow)
+        return false;
+    fc->non_ascii = true;
+    for(c = 0; c < 128; c++) {
+        uint32_t cc = lre_canonicalize(c, is_unicode);
+        for(i = 0; i < n; i++) {
+            if (is_32) {
+                low = get_u32(pc + i * 8);
+                high = get_u32(pc + i * 8 + 4);
+            } else {
+                low = get_u16(pc + i * 4);
+                high = get_u16(pc + i * 4 + 2);
+                if (high == 0xffff)
+                    high = UINT32_MAX;
+            }
+            if (cc >= low && cc <= high) {
+                fc->ascii[c >> 5] |= 1u << (c & 31);
+                break;
+            }
+        }
+    }
+    return true;
+}
