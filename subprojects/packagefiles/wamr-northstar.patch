+bool
+wasm_runtime_link_import_global(WASMModuleCommon *const module,
+                                int32 import_index, const wasm_val_t *value)
+{
+#if WASM_ENABLE_INTERP != 0
+    if (module && value && module->module_type == Wasm_Module_Bytecode) {
+        WASMModule *wasm_module = (WASMModule *)module;
+        WASMImport *wasm_import;
+
+        if ((uint32)import_index >= wasm_module->import_count)
+            return false;
+        wasm_import = &wasm_module->imports[import_index];
+        if (wasm_import->kind != WASM_IMPORT_EXPORT_KIND_GLOBAL)
+            return false;
+        switch (value->kind) {
+            case WASM_I32:
+                wasm_import->u.global.global_data_linked.i32 = value->of.i32;
+                break;
+            case WASM_I64:
+                wasm_import->u.global.global_data_linked.i64 = value->of.i64;
+                break;
+            case WASM_F32:
+                wasm_import->u.global.global_data_linked.f32 = value->of.f32;
+                break;
+            case WASM_F64:
+                wasm_import->u.global.global_data_linked.f64 = value->of.f64;
+                break;
+            default:
+                return false;
+        }
+        wasm_import->u.global.is_linked = true;
+        return true;
+    }
+#endif
+    (void)module;
+    (void)import_index;
+    (void)value;
+    return false;
+}
