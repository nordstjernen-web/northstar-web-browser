+/* Realm of the job JS_ExecutePendingJob() would run next, or NULL when
+   none is pending. An embedder that keeps per-realm state uses it to set
+   that state up before the job runs. */
+JSContext *JS_GetPendingJobContext(JSRuntime *rt)
+{
+    if (list_empty(&rt->job_list))
+        return NULL;
+    return list_entry(rt->job_list.next, JSJobEntry, link)->realm;
+}
