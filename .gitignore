!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/c_cpp_properties.json
*.sublime-*

# Logs / scratch / tool output
/render-tests-out/
wptreport.json
*.log
/.scratch/
/.cache/
/local-build.log

# Local dev artifacts (Windows/MSYS2 box)
/.tmp/
/.ccache/

# AI coding-assistant files are not accepted (see README.md, "No AI policy")
/.claude/
/.agents/
/CLAUDE.md
/AGENTS.md
perf.data

# Python bytecode
__pycache__/
*.pyc
